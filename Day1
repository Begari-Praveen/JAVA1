    public static int[] twoSum(int[] arr, int target){
        for(int i=0;i<arr.length;i++){
            for(int j=i+1;j<arr.length;j++){
                int num = arr[i]+arr[j];
                if(num == target){
                    return new int[] {i,j};
                }
            }
        }
        return new int[]{-1,-1};
    }
    public static int findMissingNumber(int[] arr){
        int n = arr.length+1;
        for(int i=1;i<=n;i++){
            boolean found = false;
            
            for(int j=0;j<arr.length;j++){
                if(arr[j] == i){
                    found = true;
                    break;
                }
            }
            if(!found){
                return i;
            }
        }
        return -1;
    }
