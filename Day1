    public static int maxProfit(int[] arr){
        int min_price = arr[0];
        int max_profit = 0;
        for(int i=1;i<arr.length;i++){
            int today_price = arr[i];
            if(today_price < min_price){
                min_price = today_price;
            }
            else{
                int profit = today_price-min_price;
                max_profit = Math.max(max_profit,profit);
            }
        }
        return max_profit;
    }
